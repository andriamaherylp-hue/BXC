# Local development
DEBUG=1
SECRET_KEY=dev-only-change-me

# PostgreSQL (required on Render; local SQLite is used only when DEBUG=1 and DATABASE_URL is absent)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_CONN_MAX_AGE=600

# Host / CSRF
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication
# Personal accounts are created immediately with username + password.
# No Gmail/SMS verification code is required.
SESSION_COOKIE_AGE=28800

# Bootstrap superuser (store these in Render Environment, never in GitHub)
BXC_ADMIN_USERNAME=grandiravecmoi
BXC_ADMIN_EMAIL=admin@example.com
BXC_ADMIN_PASSWORD=CHANGE_ME_TO_A_NEW_STRONG_SECRET
BXC_ADMIN_RESET_PASSWORD=0

WEB_CONCURRENCY=2
LOG_LEVEL=INFO
