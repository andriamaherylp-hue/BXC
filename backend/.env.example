# Local development
DEBUG=1
SECRET_KEY=dev-only-change-me

# PostgreSQL (required on Render; local SQLite is used only when DEBUG=1 and DATABASE_URL is absent)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_CONN_MAX_AGE=600

# Host / CSRF
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail SMTP verification
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=sender@gmail.com
EMAIL_HOST_PASSWORD=GOOGLE_APP_PASSWORD
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=sender@gmail.com
VERIFICATION_CODE_TTL_SECONDS=60
VERIFICATION_RESEND_SECONDS=60

# Phone verification (console for development; Twilio optional)
SMS_BACKEND=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Bootstrap superuser (store these in Render Environment, never in GitHub)
BXC_ADMIN_USERNAME=grandiravecmoi
BXC_ADMIN_EMAIL=admin@example.com
BXC_ADMIN_PASSWORD=CHANGE_ME_TO_A_NEW_STRONG_SECRET
BXC_ADMIN_RESET_PASSWORD=0

WEB_CONCURRENCY=2
