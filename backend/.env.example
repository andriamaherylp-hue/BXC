SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///db.sqlite3

# Production email verification (Gmail SMTP example).
# Gmail requires a Google App Password when 2-Step Verification is enabled.
# If the app password is copied with spaces, the application normalizes it automatically.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your-16-digit-google-app-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=your-sender@gmail.com

# Verification code lifetime / resend cooldown (seconds)
VERIFICATION_CODE_TTL_SECONDS=60
VERIFICATION_RESEND_SECONDS=60

# SMS: console or twilio
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional helper for: python manage.py ensure_superuser
# Never commit a real password. Configure these only in Render Environment.
BXC_ADMIN_USERNAME=grandiravecmoi
BXC_ADMIN_EMAIL=
BXC_ADMIN_PASSWORD=
