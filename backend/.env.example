SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///db.sqlite3

# Email verification. In DEBUG with EMAIL_HOST blank, Django prints emails to the console.
# Production Gmail SMTP example:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=your-sender@gmail.com

# Verification code lifetime / resend cooldown (seconds)
VERIFICATION_CODE_TTL_SECONDS=60
VERIFICATION_RESEND_SECONDS=60

# SMS: console or twilio
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional helper for: python manage.py ensure_superuser
# Do not commit a real password. Configure these only in Render Environment.
BXC_ADMIN_USERNAME=grandiravecmoi
BXC_ADMIN_EMAIL=
BXC_ADMIN_PASSWORD=
